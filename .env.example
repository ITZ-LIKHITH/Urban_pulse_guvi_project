# URBAN PULSE MySQL Database Configuration
# Copy this file to .env and configure your MySQL credentials

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=urban_pulse_db

# Optional: NYC Open Data App Token (recommended for high-volume API ingestion)
# NYC_OPEN_DATA_TOKEN=your_socrata_app_token_here

