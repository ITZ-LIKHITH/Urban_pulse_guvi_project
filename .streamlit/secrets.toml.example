# Streamlit Secrets Template for Urban Pulse
# Copy this file to .streamlit/secrets.toml and supply your MySQL credentials

[mysql]
host = "localhost"
port = 3306
user = "root"
password = "your_mysql_password_here"
database = "urban_pulse_db"

[database]
host = "localhost"
port = 3306
user = "root"
password = "your_mysql_password_here"
database = "urban_pulse_db"

